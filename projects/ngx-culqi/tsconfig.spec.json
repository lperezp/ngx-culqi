{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "**/*.d.ts",
    "**/*.spec.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}